{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "frontend",
      "framework": "vite",
      "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
    },
    "api": {
      "root": "backend",
      "entrypoint": "app/main.py",
      "functions": {
        "app/main.py": {
          "maxDuration": 300,
          "excludeFiles": "{.venv/**,data/**,notebooks/**,tests/**,eval/**,scripts/**,knowledge/pdfs/**,**/__pycache__/**,*.db}"
        }
      }
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
