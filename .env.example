# Copy to .env and fill in. Never commit .env; production values live in GitHub Secrets.

# --- LLM for the diagnostic assistant ---------------------------------------
# groq | gemini | none.  With no key the assistant runs in "extractive" mode
# (quotes the manuals directly), so the app still works without one.
LLM_PROVIDER=groq
# Groq: https://console.groq.com/keys   Gemini: https://aistudio.google.com/apikey
LLM_API_KEY=
# Optional model override (defaults: openai/gpt-oss-120b / gemini-2.5-flash)
LLM_MODEL=

# --- Database ------------------------------------------------------------------
# Local dev without Docker uses SQLite by default (backend/autocare.db).
# docker-compose sets DATABASE_URL itself from the POSTGRES_* values below.
# DATABASE_URL=postgresql+psycopg://autocare:autocare@localhost:5432/autocare
POSTGRES_USER=autocare
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=autocare

# --- Web -------------------------------------------------------------------------
# Comma-separated origins allowed to call the API (the Vite dev server by default).
CORS_ORIGINS=http://localhost:5173,http://localhost
# ":80" locally; your domain on the server (Caddy then issues HTTPS automatically).
SITE_ADDRESS=:80
# Shown on the About page.
REPO_URL=https://github.com/KirtiK07/autocare-ai

# --- Tuning (optional) ---------------------------------------------------------
LOG_LEVEL=INFO
GUARDRAIL_ENABLED=true
DIAGNOSE_RATE_LIMIT_PER_MINUTE=10
RETRIEVAL_K=5
RETRIEVAL_MIN_SCORE=0.2

# --- Data download (optional; or put kaggle.json in ~/.kaggle/) -----------------
KAGGLE_USERNAME=
KAGGLE_KEY=
